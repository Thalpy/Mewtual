{
  "version": 1,
  "about": "What a Score plays and what it flags (docs/design-score-layers.md section 3). Both Rust readiness and the renderer's score-voices.ts run every case. A slot key without '/' is a legacy cell (removal wins: any null value removes it, and only the selected value plays); 'S:R/L' is a layered note (add wins: nulls are ignored when a value is live, and every distinct live value plays). 'values' lists a register's alternatives, selected first. 'play' holds effective values: a note clipped to the end when it starts inside it, 'len' written only above 1. 'issues' is sparse: an omitted slot or flag is false. 'play' is in canonical voice order.",
  "cases": [
    {
      "name": "identical concurrent legacy values are one note, not a conflict",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [{ "key": "0:0", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] }],
      "issues": {},
      "play": [{ "step": 0, "row": 0, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }],
      "skipped": 0
    },
    {
      "name": "distinct concurrent legacy values: only the selected one plays, and the slot is flagged",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [{ "key": "0:0", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 2 }, { "k": "d", "pad": 3 }] }],
      "issues": { "0:0": { "conflict": true } },
      "play": [{ "step": 0, "row": 0, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 2 } }],
      "skipped": 0
    },
    {
      "name": "an absent length and a length of 1 are the same note",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [
        { "key": "3:2", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 1 }] },
        { "key": "3:2/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] }
      ],
      "issues": {},
      "play": [{ "step": 3, "row": 2, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }],
      "skipped": 0
    },
    {
      "name": "two lengths that clip to the same note at the end are one voice",
      "steps": 12, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [{ "key": "8:0/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [
        { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 8 },
        { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 6 }] }],
      "issues": { "8:0/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": { "conflict": true, "extent": true } },
      "play": [{ "step": 8, "row": 0, "value": { "k": "n", "len": 4, "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }],
      "skipped": 0
    },
    {
      "name": "two different notes placed in one place by two members both play",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [{ "key": "4:6/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [
        { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 2, "vol": 50 },
        { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 2 }] }],
      "issues": { "4:6/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": { "conflict": true, "overlap": true } },
      "play": [
        { "step": 4, "row": 6, "value": { "k": "n", "len": 2, "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "vol": 50 } },
        { "step": 4, "row": 6, "value": { "k": "n", "len": 2, "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }
      ],
      "skipped": 0
    },
    {
      "name": "a long hold overlaps every note it covers, not the one after it ends",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [
        { "key": "0:5", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 8 }] },
        { "key": "2:5/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
        { "key": "4:5/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
        { "key": "8:5/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] }
      ],
      "issues": {
        "0:5": { "overlap": true },
        "2:5/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": { "overlap": true },
        "4:5/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": { "overlap": true }
      },
      "play": [
        { "step": 0, "row": 5, "value": { "k": "n", "len": 8, "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
        { "step": 2, "row": 5, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
        { "step": 4, "row": 5, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
        { "step": 8, "row": 5, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }
      ],
      "skipped": 0
    },
    {
      "name": "a legacy cell keeps removal wins: a concurrent clear removes it",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [{ "key": "2:4", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, null] }],
      "issues": {}, "play": [], "skipped": 0
    },
    {
      "name": "a layered note is add wins: a concurrent clear does not remove it",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [{ "key": "2:4/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [null, { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] }],
      "issues": {},
      "play": [{ "step": 2, "row": 4, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }],
      "skipped": 0
    },
    {
      "name": "the same note in a legacy cell and its layer plays once",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [
        { "key": "1:1", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
        { "key": "1:1/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] }
      ],
      "issues": {},
      "play": [{ "step": 1, "row": 1, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }],
      "skipped": 0
    },
    {
      "name": "two sounds in one cell are two layers, and both play",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"],
      "slots": [
        { "key": "0:0/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "values": [{ "k": "n", "p": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "len": 4 }] },
        { "key": "0:0/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 4 }] },
        { "key": "0:0/d", "values": [{ "k": "d", "pad": 0 }] }
      ],
      "issues": {},
      "play": [
        { "step": 0, "row": 0, "value": { "k": "d", "pad": 0 } },
        { "step": 0, "row": 0, "value": { "k": "n", "len": 4, "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
        { "step": 0, "row": 0, "value": { "k": "n", "len": 4, "p": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" } }
      ],
      "skipped": 0
    },
    {
      "name": "overlap is flagged only within one sound; different sounds overlapping is what layers are for",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"],
      "slots": [
        { "key": "0:3", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 4 }] },
        { "key": "2:3/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] },
        { "key": "1:3/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "values": [{ "k": "n", "p": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "len": 2 }] },
        { "key": "4:3/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] }
      ],
      "issues": { "0:3": { "overlap": true }, "2:3/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": { "overlap": true } },
      "play": [
        { "step": 0, "row": 3, "value": { "k": "n", "len": 4, "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
        { "step": 1, "row": 3, "value": { "k": "n", "len": 2, "p": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" } },
        { "step": 2, "row": 3, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
        { "step": 4, "row": 3, "value": { "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } }
      ],
      "skipped": 0
    },
    {
      "name": "distinct concurrent values in one layer all play and are flagged; identical ones are not",
      "steps": 16, "sounds": [],
      "slots": [
        { "key": "5:0/d", "values": [{ "k": "d", "pad": 1 }, { "k": "d", "pad": 2 }, null] },
        { "key": "6:0/d", "values": [{ "k": "d", "pad": 1 }, { "k": "d", "pad": 1 }] }
      ],
      "issues": { "5:0/d": { "conflict": true } },
      "play": [
        { "step": 5, "row": 0, "value": { "k": "d", "pad": 1 } },
        { "step": 5, "row": 0, "value": { "k": "d", "pad": 2 } },
        { "step": 6, "row": 0, "value": { "k": "d", "pad": 1 } }
      ],
      "skipped": 0
    },
    {
      "name": "past the end: a note that starts inside is clipped, one that starts at or after the end is skipped",
      "steps": 16, "sounds": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
      "slots": [
        { "key": "14:0/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "len": 4, "vol": 50 }] },
        { "key": "16:0", "values": [{ "k": "d", "pad": 0 }] }
      ],
      "issues": { "14:0/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": { "extent": true }, "16:0": { "extent": true } },
      "play": [{ "step": 14, "row": 0, "value": { "k": "n", "len": 2, "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "vol": 50 } }],
      "skipped": 1
    },
    {
      "name": "a note whose sound is gone is skipped and flagged",
      "steps": 16, "sounds": [],
      "slots": [{ "key": "0:0/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "values": [{ "k": "n", "p": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }] }],
      "issues": { "0:0/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": { "recipe": true } },
      "play": [], "skipped": 1
    }
  ]
}
